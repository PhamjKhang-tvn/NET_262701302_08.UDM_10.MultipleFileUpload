<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>Udm10.Headless</AssemblyName>
    <RootNamespace>Udm10.Headless</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\BuildInfo.cs" Link="BuildInfo.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\Udm10.Shared.csproj" />
    <ProjectReference Include="..\ServerCore\Udm10.ServerCore.csproj" />
  </ItemGroup>
</Project>
